# =============================================================================
# AutoCodit Agent Backend - Docker Compose Environment (DO NOT USE LOCALHOST)
# =============================================================================

# API & Core
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL DB (Docker network = db)
DATABASE_URL=postgresql://autocodit:password@db:5432/autocodit_agent

# Redis (Docker network = redis)
REDIS_URL=redis://redis:6379/0

# Security
JWT_SECRET=super-secure-random-jwt-key

# AI Providers
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# GitHub App (fake/demo for dev)
GITHUB_APP_ID=2255973
GITHUB_WEBHOOK_SECRET=dev-secret
GITHUB_PRIVATE_KEY=not-a-real-key

# Fast local development
DEV_MODE=true
HOT_RELOAD=true
DEBUG=true
LOG_LEVEL=DEBUG

# Allowed CORS (dev only)
CORS_ORIGINS=["*"]
